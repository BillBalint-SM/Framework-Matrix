{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:abk:schema:capability-component-pattern-adoption:1.0.0",
  "title": "ABK Capability Component and Pattern Adoption Manifest",
  "description": "Strict ABK-native core contract. Upstream framework runtime, vendor extension blocks, and undeclared properties are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "kind",
    "name",
    "summary",
    "component_type",
    "scope_layer",
    "version",
    "owners",
    "source_patterns",
    "intended_abk_role",
    "autonomy_profile",
    "side_effect_profile",
    "runtime_independence",
    "lifecycle",
    "provenance",
    "permission_state",
    "evidence",
    "benchmark_scorecard_id",
    "composition"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "manifest_id": { "$ref": "#/definitions/reference_id" },
    "kind": { "enum": ["capability_component", "pattern_adoption"] },
    "name": { "type": "string", "minLength": 3, "maxLength": 120 },
    "summary": { "type": "string", "minLength": 20, "maxLength": 1200 },
    "component_type": {
      "enum": ["hook", "skill", "script", "role", "workflow", "event", "context_template", "validator", "state_contract"]
    },
    "scope_layer": { "enum": ["GLOBAL", "PROJECT", "SESSION", "LOCAL"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_owner", "outcome_owner", "review_owner"],
      "properties": {
        "component_owner": { "$ref": "#/definitions/identifier" },
        "outcome_owner": { "$ref": "#/definitions/identifier" },
        "review_owner": { "$ref": "#/definitions/identifier" }
      }
    },
    "source_patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/source_pattern" }
    },
    "intended_abk_role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem", "behavior", "inputs", "outputs", "stop_conditions"],
      "properties": {
        "problem": { "type": "string", "minLength": 20, "maxLength": 1500 },
        "behavior": { "type": "string", "minLength": 20, "maxLength": 2000 },
        "inputs": { "$ref": "#/definitions/nonempty_strings" },
        "outputs": { "$ref": "#/definitions/nonempty_strings" },
        "stop_conditions": { "$ref": "#/definitions/nonempty_strings" }
      }
    },
    "autonomy_profile": { "$ref": "#/definitions/autonomy_profile" },
    "side_effect_profile": { "$ref": "#/definitions/side_effect_profile" },
    "runtime_independence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream_runtime_required", "upstream_package_required", "codex_local_reproducible", "independence_evidence_ids"],
      "properties": {
        "upstream_runtime_required": { "const": false },
        "upstream_package_required": { "const": false },
        "codex_local_reproducible": { "type": "boolean" },
        "independence_evidence_ids": { "$ref": "#/definitions/evidence_ids" }
      }
    },
    "lifecycle": { "$ref": "#/definitions/lifecycle" },
    "provenance": { "$ref": "#/definitions/provenance" },
    "permission_state": { "$ref": "#/definitions/permission_state" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/evidence" }
    },
    "benchmark_scorecard_id": {
      "oneOf": [{ "$ref": "#/definitions/reference_id" }, { "type": "null" }]
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencies", "handoff_contracts", "conflict_boundaries"],
      "properties": {
        "dependencies": { "$ref": "#/definitions/strings" },
        "handoff_contracts": { "$ref": "#/definitions/strings" },
        "conflict_boundaries": { "$ref": "#/definitions/strings" }
      }
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 120
    },
    "reference_id": {
      "type": "string",
      "pattern": "^abk:[a-z][a-z0-9-]*:[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 180
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3, "maxLength": 1000 }
    },
    "nonempty_strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3, "maxLength": 1000 }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/identifier" }
    },
    "source_pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "repository", "commit", "path", "observed_behavior", "evidence_tier", "permission_status"],
      "properties": {
        "source_id": { "$ref": "#/definitions/identifier" },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "path": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "observed_behavior": { "type": "string", "minLength": 20, "maxLength": 2000 },
        "evidence_tier": { "enum": ["S1", "S2", "S3"] },
        "permission_status": { "enum": ["unknown", "reviewed", "permission_required", "permission_granted", "not_applicable"] }
      }
    },
    "autonomy_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_level", "delegated_scope", "checkpoint", "audit_required", "recovery_required"],
      "properties": {
        "authority_level": {
          "enum": ["ADVISORY", "PREPARE", "LOCAL_EXECUTE", "EXTERNAL_READ", "EXTERNAL_WRITE", "BOUNDED_AUTONOMOUS"]
        },
        "delegated_scope": { "type": "string", "minLength": 10, "maxLength": 1500 },
        "checkpoint": { "enum": ["NONE", "BEFORE_EXECUTION", "BEFORE_WRITE", "AFTER_EXECUTION", "REQUIRED"] },
        "audit_required": { "type": "boolean" },
        "recovery_required": { "type": "boolean" }
      }
    },
    "side_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_id", "class", "target_scope", "declared", "reversible", "recovery", "evidence_ids"],
      "properties": {
        "effect_id": { "$ref": "#/definitions/identifier" },
        "class": { "enum": ["LOCAL_READ", "LOCAL_WRITE", "PROCESS_EXECUTION", "NETWORK_READ", "EXTERNAL_WRITE", "GIT_MUTATION", "DESTRUCTIVE"] },
        "target_scope": { "type": "string", "minLength": 3, "maxLength": 1000 },
        "declared": { "const": true },
        "reversible": { "type": "boolean" },
        "recovery": { "type": "string", "minLength": 10, "maxLength": 1500 },
        "evidence_ids": { "$ref": "#/definitions/evidence_ids" }
      }
    },
    "side_effect_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations", "undocumented_effect_policy"],
      "properties": {
        "operations": { "type": "array", "items": { "$ref": "#/definitions/side_effect" } },
        "undocumented_effect_policy": { "const": "STOPPED" }
      }
    },
    "lifecycle_state": {
      "enum": [
        "DISCOVERED",
        "SOURCE_VERIFIED",
        "REPRODUCED",
        "ISOLATED_TRIAL",
        "ABK_NATIVE_PROTOTYPE",
        "COMPARATIVE_PILOT",
        "VALIDATED",
        "REJECTED",
        "DEFERRED",
        "CHOSEN",
        "ADOPTED",
        "SUPERSEDED"
      ]
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "from", "to", "occurred_at", "approval_id", "evidence_ids"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "from": { "$ref": "#/definitions/lifecycle_state" },
        "to": { "$ref": "#/definitions/lifecycle_state" },
        "occurred_at": { "type": "string", "format": "date-time" },
        "approval_id": { "oneOf": [{ "$ref": "#/definitions/identifier" }, { "type": "null" }] },
        "evidence_ids": { "$ref": "#/definitions/evidence_ids" }
      },
      "allOf": [
        {
          "if": { "properties": { "to": { "const": "CHOSEN" } } },
          "then": { "properties": { "from": { "const": "VALIDATED" } } }
        },
        {
          "if": { "properties": { "to": { "const": "ADOPTED" } } },
          "then": {
            "properties": {
              "from": { "const": "CHOSEN" },
              "approval_id": { "$ref": "#/definitions/identifier" }
            }
          }
        }
      ]
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_state", "history"],
      "properties": {
        "current_state": { "$ref": "#/definitions/lifecycle_state" },
        "history": { "type": "array", "items": { "$ref": "#/definitions/transition" } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adaptation_mode", "verbatim_copy", "license_is_quality_gate", "notes"],
      "properties": {
        "adaptation_mode": { "enum": ["behavioral_reimplementation", "template_adaptation", "verbatim_with_permission"] },
        "verbatim_copy": { "type": "boolean" },
        "license_is_quality_gate": { "const": false },
        "notes": { "type": "string", "minLength": 10, "maxLength": 1500 }
      }
    },
    "permission_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "owner", "decision_evidence_ids"],
      "properties": {
        "status": { "enum": ["unknown", "not_required", "required", "requested", "granted"] },
        "owner": { "$ref": "#/definitions/identifier" },
        "decision_evidence_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/identifier" } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "type", "status", "locator", "content_sha256", "summary"],
      "properties": {
        "evidence_id": { "$ref": "#/definitions/identifier" },
        "type": { "enum": ["source", "test", "runtime", "review", "decision", "benchmark"] },
        "status": { "enum": ["planned", "verified", "passed", "failed", "inconclusive"] },
        "locator": { "type": "string", "minLength": 3, "maxLength": 1000 },
        "content_sha256": { "$ref": "#/definitions/sha256" },
        "summary": { "type": "string", "minLength": 10, "maxLength": 1000 }
      }
    }
  }
}
