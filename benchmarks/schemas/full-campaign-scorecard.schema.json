{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:abk:schema:full-campaign-scorecard:1.0.0",
  "title": "Codex-local full-campaign evidence and scorecard gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "ledger_id", "campaign_id", "captured_at", "status", "outcome", "benchmark", "hard_gates", "branch_summaries", "evidence", "blockers"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0.0" },
    "ledger_id": { "type": "string", "pattern": "^abk:ledger:full-campaign:[a-z0-9-]+$" },
    "campaign_id": { "const": "abk:benchmark-campaign:artifact-dag-core-v1" },
    "captured_at": { "type": "string", "minLength": 20 },
    "status": { "enum": ["benchmark_pending", "running", "complete", "inconclusive"] },
    "outcome": { "enum": ["UNSCORED", "REJECTED", "CANDIDATE", "CHOSEN"] },
    "benchmark": { "$ref": "#/definitions/benchmark" },
    "hard_gates": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/definitions/hard_gate" } },
    "branch_summaries": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/definitions/branch_summary" } },
    "evidence": { "type": "array", "items": { "$ref": "#/definitions/evidence" }, "uniqueItems": true },
    "blockers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 20 } }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "benchmark": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "case_count", "common_case_count", "specific_case_count", "branches", "primary_cell_count", "expected_raw_runs", "completed_primary_cells", "completed_raw_runs", "run_evidence_ids"],
      "properties": {
        "status": { "enum": ["planned", "running", "complete", "inconclusive"] },
        "case_count": { "const": 10 }, "common_case_count": { "const": 6 }, "specific_case_count": { "const": 4 },
        "branches": { "const": ["control", "source_native", "abk_native"] }, "primary_cell_count": { "const": 30 }, "expected_raw_runs": { "const": 66 },
        "completed_primary_cells": { "type": "integer", "minimum": 0, "maximum": 30 }, "completed_raw_runs": { "type": "integer", "minimum": 0, "maximum": 66 },
        "run_evidence_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } }
      }
    },
    "hard_gate": {
      "type": "object", "additionalProperties": false, "required": ["gate_id", "status", "rationale", "evidence_ids"],
      "properties": { "gate_id": { "enum": ["observable_state_and_errors", "testable_behavior", "declared_authority_and_side_effects", "reversible_or_recoverable", "upstream_runtime_independence", "no_undocumented_side_effects"] }, "status": { "enum": ["pass", "fail", "pending"] }, "rationale": { "type": "string", "minLength": 10, "maxLength": 1000 }, "evidence_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } } }
    },
    "branch_summary": {
      "type": "object", "additionalProperties": false, "required": ["branch", "expected_raw_runs", "completed_raw_runs", "completed_primary_cells", "run_evidence_ids"],
      "properties": { "branch": { "enum": ["control", "source_native", "abk_native"] }, "expected_raw_runs": { "const": 22 }, "completed_raw_runs": { "type": "integer", "minimum": 0, "maximum": 22 }, "completed_primary_cells": { "type": "integer", "minimum": 0, "maximum": 10 }, "run_evidence_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } } }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "branch", "case_id", "repeat", "status", "terminal_state", "exit_code", "oracle_status", "run_relative_path", "run_sha256", "oracle_relative_path", "oracle_sha256"],
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "branch": { "enum": ["control", "source_native", "abk_native"] }, "case_id": { "type": "string", "pattern": "^(COM|SPC)-[0-9]{2}-[a-z][a-z0-9-]*$" }, "repeat": { "enum": [1, 2, 3] }, "status": { "enum": ["passed", "failed", "inconclusive"] }, "terminal_state": { "enum": ["SUCCEEDED", "RECOVERED", "STOPPED", "REJECTED", "FAILED", "BLOCKED"] }, "exit_code": { "type": "integer" }, "oracle_status": { "enum": ["passed", "failed", "inconclusive", "stopped", "partial", "invalidated", "UNSCORED"] }, "run_relative_path": { "type": "string", "pattern": "^benchmarks/campaigns/artifact-dag-core-v1/runs/.+/run\\.json$" }, "run_sha256": { "$ref": "#/definitions/sha256" }, "oracle_relative_path": { "type": "string", "pattern": "^benchmarks/campaigns/artifact-dag-core-v1/runs/.+/oracle-result\\.json$" }, "oracle_sha256": { "$ref": "#/definitions/sha256" }
      }
    }
  }
}
