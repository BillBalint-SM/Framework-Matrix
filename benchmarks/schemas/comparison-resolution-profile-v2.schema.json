{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:abk:schema:comparison-resolution-profile-v2:1.0.0",
  "title": "Framework-Matrix v2 comparison resolution profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "protocol_id", "source_snapshot", "baseline_branch", "eligible_branches", "expected_normalizations", "gate_overrides"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0.0" },
    "profile_id": { "const": "abk:resolution-profile:artifact-dag-core-v2" },
    "protocol_id": { "const": "abk:benchmark:pattern-adoption-v2" },
    "source_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "expected_raw_runs"],
      "properties": {
        "path": { "const": "benchmarks/campaigns/artifact-dag-core-v1/runs/full-campaign-20260805/campaign-run-index.json" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "expected_raw_runs": { "const": 66 }
      }
    },
    "baseline_branch": { "const": "control" },
    "eligible_branches": {
      "type": "array", "const": ["source_native", "abk_native"]
    },
    "expected_normalizations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case_id", "branches", "raw_status", "error_code", "assessment_status", "rationale"],
        "properties": {
          "case_id": { "const": "SPC-01-domain-boundary" },
          "branches": { "const": ["source_native", "abk_native"] },
          "raw_status": { "const": "inconclusive" },
          "error_code": { "const": "DEPENDENCY_OUT_OF_ROOT" },
          "assessment_status": { "const": "passed" },
          "rationale": { "type": "string", "minLength": 20, "maxLength": 500 }
        }
      }
    },
    "gate_overrides": {
      "type": "object", "additionalProperties": false,
      "required": ["source_native", "abk_native"],
      "properties": {
        "source_native": { "$ref": "#/definitions/gate_override_list" },
        "abk_native": { "$ref": "#/definitions/gate_override_list" }
      }
    }
  },
  "definitions": {
    "gate_override_list": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["gate_id", "status", "evidence_scope", "rationale"],
        "properties": {
          "gate_id": { "enum": ["reversible_or_recoverable", "no_undocumented_side_effects"] },
          "status": { "const": "pass" },
          "evidence_scope": { "const": "branch_all" },
          "rationale": { "type": "string", "minLength": 20, "maxLength": 500 }
        }
      }
    }
  }
}
