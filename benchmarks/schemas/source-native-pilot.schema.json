{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:abk:schema:source-native-pilot:1.0.0",
  "title": "Bounded source-native pilot ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "pilot_id",
    "campaign_id",
    "branch",
    "captured_at",
    "status",
    "full_campaign",
    "raw_runs",
    "expected_full_campaign_runs",
    "campaign_sha256",
    "schema_sha256",
    "source_snapshot_sha256",
    "source_manifest_sha256",
    "entrypoint_sha256",
    "pilot_schema_sha256",
    "results",
    "run_evidence_ids",
    "scorecard_state",
    "blockers"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0.0" },
    "pilot_id": { "type": "string", "pattern": "^abk:pilot:[a-z0-9-]+$" },
    "campaign_id": { "const": "abk:benchmark-campaign:artifact-dag-core-v1" },
    "branch": { "const": "source_native" },
    "captured_at": { "type": "string", "minLength": 20 },
    "status": { "const": "passed" },
    "full_campaign": { "const": false },
    "raw_runs": { "const": 10 },
    "expected_full_campaign_runs": { "const": 66 },
    "campaign_sha256": { "$ref": "#/definitions/sha256" },
    "schema_sha256": { "$ref": "#/definitions/sha256" },
    "source_snapshot_sha256": { "$ref": "#/definitions/sha256" },
    "source_manifest_sha256": { "$ref": "#/definitions/sha256" },
    "entrypoint_sha256": { "$ref": "#/definitions/sha256" },
    "pilot_schema_sha256": { "$ref": "#/definitions/sha256" },
    "results": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/definitions/result" }
    },
    "run_evidence_ids": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    },
    "scorecard_state": { "const": "UNSCORED" },
    "blockers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 20 } }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "case_id",
        "status",
        "expected_terminal_state",
        "terminal_state",
        "exit_code",
        "oracle_status",
        "error_code",
        "run_relative_path",
        "run_sha256",
        "oracle_relative_path",
        "oracle_sha256"
      ],
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "case_id": { "type": "string", "pattern": "^(COM|SPC)-[0-9]{2}-[a-z][a-z0-9-]*$" },
        "status": { "const": "passed" },
        "expected_terminal_state": { "enum": ["SUCCEEDED", "RECOVERED", "STOPPED", "REJECTED", "FAILED"] },
        "terminal_state": { "enum": ["SUCCEEDED", "RECOVERED", "STOPPED", "REJECTED", "FAILED"] },
        "exit_code": { "type": "integer" },
        "oracle_status": { "enum": ["passed", "failed", "partial", "inconclusive", "invalidated", "stopped"] },
        "error_code": { "type": ["string", "null"] },
        "run_relative_path": { "type": "string", "pattern": "^benchmarks/campaigns/artifact-dag-core-v1/runs/.+/run\\.json$" },
        "run_sha256": { "$ref": "#/definitions/sha256" },
        "oracle_relative_path": { "type": "string", "pattern": "^benchmarks/campaigns/artifact-dag-core-v1/runs/.+/oracle-result\\.json$" },
        "oracle_sha256": { "$ref": "#/definitions/sha256" }
      }
    }
  }
}
