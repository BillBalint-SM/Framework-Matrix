{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:abk:schema:network-policy-audit:1.0.0",
  "title": "Windows Firewall network-deny audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "audit_id",
    "campaign_id",
    "host",
    "status",
    "started_at",
    "ended_at",
    "is_admin",
    "rule",
    "runner_probe_status",
    "runner_probe_connections_observed",
    "error_code",
    "findings",
    "limitations"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0.0" },
    "audit_id": { "type": "string", "pattern": "^abk:network-policy-audit:[a-z][a-z0-9-]*$" },
    "campaign_id": { "const": "abk:benchmark-campaign:artifact-dag-core-v1" },
    "host": { "const": "codex" },
    "status": { "enum": ["PASS", "BLOCKED", "FAILED"] },
    "started_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "ended_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "is_admin": { "type": "boolean" },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "program", "direction", "action", "profile", "created", "removed", "cleanup_verified"],
      "properties": {
        "display_name": { "type": "string", "pattern": "^Framework-Matrix-Temp-Deny-[a-z0-9-]+$" },
        "program": { "type": "string", "minLength": 1 },
        "direction": { "const": "Outbound" },
        "action": { "const": "Block" },
        "profile": { "const": "Any" },
        "created": { "type": "boolean" },
        "removed": { "type": "boolean" },
        "cleanup_verified": { "const": true }
      }
    },
    "runner_probe_status": { "enum": ["NOT_RUN", "PASS", "FAILED"] },
    "runner_probe_connections_observed": { "type": "integer", "minimum": 0 },
    "error_code": { "type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]+$" },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "status", "detail"],
        "properties": {
          "check": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "status": { "enum": ["PASS", "BLOCKED", "FAILED"] },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
