{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:abk:schema:branch-snapshot:1.0.0",
  "title": "Framework-Matrix branch snapshot descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "snapshot_id",
    "campaign_id",
    "branch",
    "status",
    "execution_status",
    "captured_at",
    "provenance",
    "scope",
    "inventory",
    "disposition"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0.0" },
    "snapshot_id": { "type": "string", "pattern": "^abk:branch-snapshot:(source-native|abk-native)-artifact-dag-core-v1$" },
    "campaign_id": { "const": "abk:benchmark-campaign:artifact-dag-core-v1" },
    "branch": { "enum": ["source_native", "abk_native"] },
    "status": { "enum": ["READY_FOR_ENTRYPOINT", "BLOCKED", "NOT_COMPARABLE"] },
    "execution_status": { "const": "NOT_EXECUTED" },
    "captured_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "source_ref", "observed_path", "revision", "revision_type", "transport", "worktree_status"],
      "properties": {
        "source_kind": { "enum": ["framework-matrix-source-snapshot", "separate-project-git-commit"] },
        "source_ref": { "type": "string", "minLength": 1 },
        "observed_path": { "type": "string", "minLength": 1 },
        "revision": { "$ref": "#/definitions/sha1" },
        "revision_type": { "enum": ["upstream-commit", "git-commit"] },
        "transport": { "const": "local-read-only" },
        "worktree_status": { "enum": ["clean-snapshot", "dirty-external-worktree"] }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included_paths", "excluded_paths", "source_code_copied_into_framework_matrix", "git_linked_into_framework_matrix", "runtime_included"],
      "properties": {
        "included_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "excluded_paths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "source_code_copied_into_framework_matrix": { "const": false },
        "git_linked_into_framework_matrix": { "const": false },
        "runtime_included": { "const": false }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory_sha256", "entries"],
      "properties": {
        "inventory_sha256": { "$ref": "#/definitions/sha256" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "digest", "digest_algorithm", "size"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "digest": { "type": "string", "pattern": "^[a-f0-9]{40}$|^[a-f0-9]{64}$" },
              "digest_algorithm": { "enum": ["SHA-256", "git-blob-SHA-1"] },
              "size": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_disposition", "reason", "next_action"],
      "properties": {
        "candidate_disposition": { "enum": ["READY_FOR_CLEAN_ROOM_ENTRYPOINT", "BLOCKED", "NOT_COMPARABLE"] },
        "reason": { "type": "string", "minLength": 20 },
        "next_action": { "type": "string", "minLength": 20 }
      }
    }
  },
  "definitions": {
    "sha1": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
