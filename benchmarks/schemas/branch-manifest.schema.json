{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:abk:schema:branch-manifest:1.0.0",
  "title": "Codex-local benchmark branch manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "manifest_id",
    "campaign_id",
    "host",
    "path_base",
    "entrypoint_path",
    "entrypoint_sha256",
    "snapshot_ref",
    "snapshot_sha256",
    "reads",
    "writes",
    "capabilities",
    "authority_level",
    "checkpoint",
    "runtime",
    "network",
    "credentials",
    "production_resources",
    "external_writes",
    "git_mutation",
    "child_processes",
    "cross_run_reads",
    "cross_branch_reads",
    "real_user_config_reads_or_writes",
    "undocumented_effect_policy"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0.0" },
    "manifest_id": { "type": "string", "pattern": "^abk:branch-manifest:(?!PENDING$)[a-z][a-z0-9-]*$" },
    "campaign_id": { "const": "abk:benchmark-campaign:artifact-dag-core-v1" },
    "host": { "const": "codex" },
    "path_base": { "const": "repository" },
    "entrypoint_path": { "type": "string", "pattern": "^(?!PENDING$)(?![A-Za-z]:)(?![\\\\/])[A-Za-z0-9._/-]+$" },
    "entrypoint_sha256": { "$ref": "#/definitions/sha256" },
    "snapshot_ref": { "type": "string", "pattern": "^(?!PENDING$)[a-z][a-z0-9:._-]+$" },
    "snapshot_sha256": { "$ref": "#/definitions/sha256" },
    "reads": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "writes": { "const": ["runs/<case-id>/control/R<n>/**"] },
    "capabilities": { "const": ["LOCAL_READ", "LOCAL_WRITE", "PROCESS_EXECUTION"] },
    "authority_level": { "const": "LOCAL_EXECUTE" },
    "checkpoint": { "const": "BEFORE_EXECUTION" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["powershell_executable", "powershell_major", "command_template"],
      "properties": {
        "powershell_executable": { "const": "pwsh.exe" },
        "powershell_major": { "const": 7 },
        "command_template": { "const": "pwsh.exe -NoLogo -NoProfile -NonInteractive -File {entrypoint_path} -RequestPath {run_root}/request.json" }
      }
    },
    "network": { "const": "DENY" },
    "credentials": { "const": "DENY" },
    "production_resources": { "const": "DENY" },
    "external_writes": { "const": "DENY" },
    "git_mutation": { "const": "DENY" },
    "child_processes": { "const": "DENY" },
    "cross_run_reads": { "const": "DENY" },
    "cross_branch_reads": { "const": "DENY" },
    "real_user_config_reads_or_writes": { "const": "DENY" },
    "undocumented_effect_policy": { "const": "STOPPED" }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
