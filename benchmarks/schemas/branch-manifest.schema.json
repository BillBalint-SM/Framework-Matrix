{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:abk:schema:branch-manifest:1.0.0",
  "title": "Codex-local benchmark branch manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "manifest_id",
    "campaign_id",
    "host",
    "path_base",
    "entrypoint_path",
    "entrypoint_sha256",
    "snapshot_ref",
    "snapshot_sha256",
    "reads",
    "writes",
    "capabilities",
    "authority_level",
    "checkpoint",
    "runtime",
    "network",
    "credentials",
    "production_resources",
    "external_writes",
    "git_mutation",
    "child_processes",
    "cross_run_reads",
    "cross_branch_reads",
    "real_user_config_reads_or_writes",
    "undocumented_effect_policy"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0.0" },
    "manifest_id": { "type": "string", "pattern": "^abk:branch-manifest:(?!PENDING$)[a-z][a-z0-9-]*$" },
    "campaign_id": { "const": "abk:benchmark-campaign:artifact-dag-core-v1" },
    "host": { "const": "codex" },
    "path_base": { "const": "repository" },
    "branch_id": { "enum": ["control", "source_native", "abk_native"] },
    "entrypoint_path": { "type": "string", "pattern": "^(?!PENDING$)(?![A-Za-z]:)(?![\\\\/])[A-Za-z0-9._/-]+$" },
    "entrypoint_sha256": { "$ref": "#/definitions/sha256" },
    "snapshot_ref": { "type": "string", "pattern": "^(?!PENDING$)[a-z][a-z0-9:._-]+$" },
    "snapshot_sha256": { "$ref": "#/definitions/sha256" },
    "snapshot_path": { "type": "string", "pattern": "^(?!PENDING$)(?![A-Za-z]:)(?![\\\\/])[A-Za-z0-9._/-]+$" },
    "reads": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "writes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "type": "string", "pattern": "^runs/<case-id>/(control|source_native|abk_native)/R<n>/\\*\\*$" }
    },
    "capabilities": { "const": ["LOCAL_READ", "LOCAL_WRITE", "PROCESS_EXECUTION"] },
    "authority_level": { "const": "LOCAL_EXECUTE" },
    "checkpoint": { "const": "BEFORE_EXECUTION" },
    "status": { "enum": ["READY_FOR_ENTRYPOINT", "READY_FOR_EXECUTION", "BLOCKED", "NOT_COMPARABLE", "REJECTED"] },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_disposition", "reason", "next_action"],
      "properties": {
        "candidate_disposition": { "enum": ["READY_FOR_CLEAN_ROOM_ENTRYPOINT", "RUNNABLE", "BLOCKED", "NOT_COMPARABLE", "REJECTED"] },
        "reason": { "type": "string", "minLength": 20, "maxLength": 1000 },
        "next_action": { "type": "string", "minLength": 20, "maxLength": 1000 }
      }
    },
    "execution_status": { "const": "NOT_EXECUTED" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["powershell", "node", "python", "custom_local"] },
        "executable": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$" },
        "command_template": { "type": "string", "minLength": 1, "maxLength": 500 },
        "powershell_executable": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "powershell_major": { "type": "integer", "minimum": 1, "maximum": 99 }
      }
    },
    "network": { "const": "DENY" },
    "credentials": { "const": "DENY" },
    "production_resources": { "const": "DENY" },
    "external_writes": { "const": "DENY" },
    "git_mutation": { "const": "DENY" },
    "child_processes": { "const": "DENY" },
    "cross_run_reads": { "const": "DENY" },
    "cross_branch_reads": { "const": "DENY" },
    "real_user_config_reads_or_writes": { "const": "DENY" },
    "undocumented_effect_policy": { "const": "STOPPED" }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "allOf": [
    {
      "if": {
        "required": ["branch_id"],
        "properties": { "branch_id": { "const": "control" } }
      },
      "then": {
        "properties": {
          "writes": { "const": ["runs/<case-id>/control/R<n>/**"] }
        }
      }
    },
    {
      "if": {
        "required": ["branch_id"],
        "properties": { "branch_id": { "const": "source_native" } }
      },
      "then": {
        "required": ["branch_id", "snapshot_path", "status", "disposition", "execution_status"],
        "properties": {
          "writes": { "const": ["runs/<case-id>/source_native/R<n>/**"] },
          "runtime": {
            "required": ["kind", "executable", "version", "command_template"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["branch_id"],
        "properties": { "branch_id": { "const": "abk_native" } }
      },
      "then": {
        "required": ["branch_id", "snapshot_path", "status", "disposition", "execution_status"],
        "properties": {
          "writes": { "const": ["runs/<case-id>/abk_native/R<n>/**"] },
          "runtime": {
            "required": ["kind", "executable", "version", "command_template"]
          }
        }
      }
    }
  ]
}
