{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:abk:schema:benchmark-campaign:1.0.0",
  "title": "Codex-local three-branch benchmark campaign",
  "description": "Strict pre-execution campaign contract. A pending campaign contains declarations only and cannot claim an adoption outcome.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "campaign_id",
    "protocol_id",
    "status",
    "outcome",
    "host",
    "component",
    "source_pattern",
    "branches",
    "cases",
    "run_policy",
    "isolation",
    "evidence_layout",
    "completed_primary_cells",
    "completed_raw_runs",
    "run_evidence_ids"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.0.0" },
    "campaign_id": { "type": "string", "pattern": "^abk:benchmark-campaign:[a-z][a-z0-9-]*$" },
    "protocol_id": { "const": "abk:benchmark:pattern-adoption-v1" },
    "status": { "enum": ["benchmark_pending", "running", "complete", "inconclusive", "superseded"] },
    "outcome": { "enum": ["UNSCORED", "REJECTED", "CANDIDATE", "CHOSEN"] },
    "host": { "const": "codex" },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "name", "pattern_id"],
      "properties": {
        "manifest_id": { "$ref": "#/definitions/reference_id" },
        "name": { "type": "string", "minLength": 3, "maxLength": 160 },
        "pattern_id": { "$ref": "#/definitions/identifier" }
      }
    },
    "source_pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "path", "evidence_locator"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "path": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidence_locator": { "type": "string", "minLength": 3, "maxLength": 1000 }
      }
    },
    "branches": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["control", "source_native", "abk_native"] }
    },
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/definitions/case" }
    },
    "run_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_cell_count", "expected_raw_runs"],
      "properties": {
        "primary_cell_count": { "const": 30 },
        "expected_raw_runs": { "type": "integer", "minimum": 30, "maximum": 90 }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_network", "credentials", "production_resources", "external_writes", "git_mutation", "workspace_root", "environment_roots", "forbidden_inputs"],
      "properties": {
        "external_network": { "const": false },
        "credentials": { "const": false },
        "production_resources": { "const": false },
        "external_writes": { "const": false },
        "git_mutation": { "const": false },
        "workspace_root": { "const": "runs" },
        "environment_roots": { "$ref": "#/definitions/nonempty_strings" },
        "forbidden_inputs": { "$ref": "#/definitions/nonempty_strings" }
      }
    },
    "evidence_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "run_path_template", "required_files"],
      "properties": {
        "root": { "const": "runs" },
        "run_path_template": { "const": "runs/{case_id}/{branch_id}/R{repeat}/" },
        "required_files": {
          "const": [
            "run.json",
            "stdout.log",
            "stderr.log",
            "tool-events.jsonl",
            "output-inventory.json",
            "oracle-result.json"
          ]
        }
      }
    },
    "completed_primary_cells": { "type": "integer", "minimum": 0, "maximum": 30 },
    "completed_raw_runs": { "type": "integer", "minimum": 0, "maximum": 90 },
    "run_evidence_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/identifier" } }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 120
    },
    "reference_id": {
      "type": "string",
      "pattern": "^abk:[a-z][a-z0-9-]*:[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 180
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nonempty_strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "case_class", "title", "fixture", "fixture_sha256", "model_dependent", "repeats", "timeout_seconds", "oracle", "stop_condition"],
      "properties": {
        "case_id": { "type": "string", "pattern": "^(COM|SPC)-[0-9]{2}-[a-z][a-z0-9-]*$" },
        "case_class": { "enum": ["common", "component_specific"] },
        "title": { "type": "string", "minLength": 10, "maxLength": 200 },
        "fixture": { "type": "string", "minLength": 1, "maxLength": 500 },
        "fixture_sha256": { "$ref": "#/definitions/sha256" },
        "model_dependent": { "type": "boolean" },
        "repeats": { "enum": [1, 3] },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "oracle": { "type": "string", "minLength": 20, "maxLength": 1000 },
        "stop_condition": { "type": "string", "minLength": 20, "maxLength": 1000 }
      }
    }
  }
}
